{{!-- §2–§8, book pp. 16–18: the hero-creation screens inside the level-up
  window (module/apps/level-up-app.mjs, helpers/hero-creation-flow.mjs).
  Built from the same pieces as the hero's own dialogs: `.hg-tooltip` frame
  and fill (dialog_frame_<color>, keyed by `data-color`), `.hg-confirm__block`
  sections, `.hg-option-list` rows (gold = chosen), and the level-up
  window's own OK button (`.hg-lvlup__confirm`). Everything rolled is shown
  already rolled — the dice are on the actor. --}}
<div class="hg-tooltip hg-creation" data-color="{{effectivePanelColor}}">
  {{#if (eq creationScreen "setup")}}
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Creation.SetupTitle'}}</p>

    {{!-- p. 16: the random second secondary skill. --}}
    <div class="hg-confirm__block">
      <p class="hg-confirm__block-title">{{localize 'HEROES_GLORY.Creation.SkillSection'}}</p>
      <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.SkillRolled' die=pending.skillDie skill=(localize skillLabelKey)}}</p>
      {{#if plan.skill.upgradesBase}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.SkillUpgradesBase' skill=(localize baseSkillLabelKey)}}</p>
      {{else if plan.skillAlreadyOwned}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.SkillAlreadyOwned'}}</p>
      {{else}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.SkillNew'}}</p>
      {{/if}}
    </div>

    {{!-- p. 17: the ready-made starting weapon; a shooter takes two. --}}
    <div class="hg-confirm__block">
      <p class="hg-confirm__block-title">{{localize 'HEROES_GLORY.Creation.WeaponSection'}}</p>
      {{#each weapons}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.WeaponLine' name=name damage=damage}}</p>
      {{/each}}
      <div class="hg-option-list hg-creation__toggles">
        <button type="button" class="hg-option-list__item" data-action="creationToggleArcher"
          {{#if archer}}data-current="true"{{/if}}>{{localize 'HEROES_GLORY.Creation.ArcherToggle'}}</button>
      </div>
    </div>

    {{!-- p. 17: Книга Магии and 1st-level spells of choice. --}}
    <div class="hg-confirm__block">
      <p class="hg-confirm__block-title">{{localize 'HEROES_GLORY.Creation.SpellbookSection'}}</p>
      {{#if plan.spellbook.book}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.SpellbookPick' count=plan.spellbook.spellChoices}}</p>
        <div class="hg-option-list hg-creation__spells">
          {{#each spells}}
            <button type="button" class="hg-option-list__item" data-action="creationToggleSpell" data-spell="{{name}}"
              {{#if checked}}data-current="true"{{/if}}>{{name}}</button>
          {{/each}}
        </div>
      {{else}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.SpellbookNone'}}</p>
      {{/if}}
      {{#if raceItems}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.DjinnGrant' items=raceItems}}</p>
      {{/if}}
    </div>

    {{!-- p. 18: 2d6 × 10 gold. --}}
    <div class="hg-confirm__block">
      <p class="hg-confirm__block-title">{{localize 'HEROES_GLORY.Creation.GoldSection'}}</p>
      <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.GoldRolled' dice=goldDiceText sum=plan.goldSum gold=plan.gold}}</p>
    </div>

    {{!-- p. 18: d6 type, then the 2d6 row of that table. --}}
    <div class="hg-confirm__block">
      <p class="hg-confirm__block-title">{{localize 'HEROES_GLORY.Creation.ArtifactSection'}}</p>
      <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.ArtifactType' die=pending.artifactTypeDie type=(localize artifactTypeLabelKey)}}</p>
      {{#if artifactName}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.ArtifactRow' row=pending.artifactRow name=artifactName}}{{#if pending.artifactRerolls}} {{localize 'HEROES_GLORY.Creation.ArtifactRerolls' count=pending.artifactRerolls}}{{/if}}</p>
        {{#if artifactBonus}}<p class="hg-confirm__block-text">{{artifactBonus}}</p>{{/if}}
      {{else}}
        <p class="hg-confirm__block-text">{{localize 'HEROES_GLORY.Creation.ArtifactMissing'}}</p>
      {{/if}}
    </div>

    <button type="button" class="hg-lvlup__confirm hg-creation__next" data-action="creationNext"
      {{#unless canNext}}disabled{{/unless}} aria-label="{{localize 'HEROES_GLORY.Creation.NextHint'}}"></button>
  {{else}}
    {{!-- The target level: 0 keeps the book's start (p. 21), N runs the
      ordinary level-ups one by one in this same window. --}}
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Creation.LevelTitle'}}</p>
    <p>{{localize 'HEROES_GLORY.Creation.LevelHint'}}</p>
    <div class="hg-option-list hg-creation__levels">
      {{#each levels}}
        <button type="button" class="hg-option-list__item" data-action="creationPickLevel" data-level="{{level}}"
          {{#if current}}data-current="true"{{/if}}>{{label}}</button>
      {{/each}}
    </div>
    <button type="button" class="hg-lvlup__confirm hg-creation__next" data-action="creationNext"
      aria-label="{{localize 'HEROES_GLORY.Creation.NextHint'}}"></button>
  {{/if}}
</div>
