<div class="heroes-glory-chat-card heroes-glory-chat-card--spell">
  {{!-- Headline: always visible. The title is the details toggle
    (chat.mjs, activateChatListeners). --}}
  <h3 class="heroes-glory-chat-card__title heroes-glory-chat-card__toggle" data-action="hg-toggle-details">
    {{localize 'HEROES_GLORY.Roll.SpellTitle' caster=casterName spell=spellName}}
  </h3>
  <p class="heroes-glory-chat-card__line">{{localize variantLabelKey}}</p>
  {{#if description}}
    <p class="heroes-glory-chat-card__description">{{description}}</p>
  {{/if}}

  {{!-- §6.4: a spell with targets — one line per target, from the same
    resolveSpellResolution / resolveModifierSpellResolution the GM's
    confirm applies (roll-actions.mjs). --}}
  {{!-- Group Г: a Стена Огня card — who stepped in or started the turn there. --}}
  {{#if fieldTriggerLine}}
    <p class="heroes-glory-chat-card__line">{{fieldTriggerLine}}</p>
  {{/if}}
  {{#if targetSpell}}
    {{#if noTarget}}
      <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.NoTarget'}}</p>
    {{/if}}
    {{!-- Step 5: the chosen cell of an area spell. --}}
    {{#if areaCenterLine}}
      <p class="heroes-glory-chat-card__line">{{areaCenterLine}}</p>
    {{/if}}
    {{#if excludable}}
      {{!-- Steps 4, 5: per-target «исключить» / «вернуть», the GM only (chat.mjs). --}}
      {{#each targetRows}}
        <p class="heroes-glory-chat-card__damage{{#if excluded}} heroes-glory-chat-card__line--muted{{/if}}">{{text}}
          <button type="button" class="heroes-glory-chat-card__exclude-btn" data-action="hg-spell-exclude" data-index="{{index}}">
            {{#if excluded}}{{localize 'HEROES_GLORY.Roll.SpellTargetInclude'}}{{else}}{{localize 'HEROES_GLORY.Roll.SpellTargetExclude'}}{{/if}}
          </button>
        </p>
      {{/each}}
    {{else}}
      {{#each targetLines}}
        <p class="heroes-glory-chat-card__damage">{{this}}</p>
      {{/each}}
    {{/if}}
    {{!-- p. 32: the lasting spell this cast ends (a fourth one). --}}
    {{#if endCastLine}}
      <p class="heroes-glory-chat-card__line">{{endCastLine}}</p>
    {{/if}}
  {{/if}}

  {{!-- Details: collapsed by default. --}}
  <div class="heroes-glory-chat-card__details">
    {{#if damageSpell}}
      {{#each breakdown}}
        <p class="heroes-glory-chat-card__line">{{this}}</p>
      {{/each}}
      <p class="heroes-glory-chat-card__line">{{totalLine}}</p>
    {{/if}}
    {{#if rangeUnknown}}
      <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.SpellRangeUnknown'}}</p>
    {{/if}}
    {{#if schoolLabelKey}}
      <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.SpellSchool' school=(localize schoolLabelKey)}}</p>
    {{/if}}
    {{#unless fieldTriggerLine}}
    <p class="heroes-glory-chat-card__line">
      {{localize 'HEROES_GLORY.Roll.ManaCost' cost=manaCost}}
      —
      {{localize 'HEROES_GLORY.Roll.ManaRemaining' mana=manaRemaining}}
    </p>
    {{/unless}}
  </div>

  {{#if canConfirm}}
    <button type="button" class="heroes-glory-chat-card__confirm-btn" data-action="hg-confirm-spell"
      title="{{localize confirmHintKey}}">
      {{localize 'HEROES_GLORY.Roll.ConfirmButton'}}
    </button>
  {{else if confirmed}}
    <p class="heroes-glory-chat-card__line heroes-glory-chat-card__applied">{{localize 'HEROES_GLORY.Roll.Applied'}}</p>
  {{/if}}
</div>
