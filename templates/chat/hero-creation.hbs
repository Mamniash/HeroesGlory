<div class="heroes-glory-chat-card heroes-glory-chat-card--hero-creation">
  <h3 class="heroes-glory-chat-card__title">{{localize 'HEROES_GLORY.Creation.ChatTitle' actor=actorName}}</h3>
  <p class="heroes-glory-chat-card__line">
    {{localize 'HEROES_GLORY.Creation.SkillRolled' die=dice.skillDie skill=(localize skillLabelKey)}}{{#if upgradesBase}} — {{localize 'HEROES_GLORY.Creation.SkillUpgradesBase' skill=(localize baseSkillLabelKey)}}{{/if}}
  </p>
  {{#if book}}
    <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Creation.ChatSpellbook'}}</p>
  {{/if}}
  {{#if raceItems}}
    <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Creation.DjinnGrant' items=raceItems}}</p>
  {{/if}}
  {{#each weapons}}
    <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Creation.ChatWeapon' name=name damage=damage}}</p>
  {{/each}}
  <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Creation.GoldRolled' dice=goldDiceText sum=goldSum gold=gold}}</p>
  {{#if artifactLines}}
    {{#each artifactLines}}
      <p class="heroes-glory-chat-card__line">{{this}}</p>
    {{/each}}
  {{else}}
    <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Creation.ArtifactPending'}}</p>
  {{/if}}
</div>
