<div class="heroes-glory-chat-card heroes-glory-chat-card--attack">
  {{!-- Headline: always visible. The title is the details toggle
    (chat.mjs, activateChatListeners). --}}
  <h3 class="heroes-glory-chat-card__title heroes-glory-chat-card__toggle" data-action="hg-toggle-details">
    {{#if targetName}}
      {{localize 'HEROES_GLORY.Roll.AttackTitleTarget' attacker=attackerName target=targetName}}
    {{else}}
      {{localize 'HEROES_GLORY.Roll.AttackTitle' attacker=attackerName}}
    {{/if}}
  </h3>

  {{#unless targetName}}
    <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.NoTarget'}}</p>
  {{/unless}}

  {{!-- Shown/hidden per viewer by chat.mjs, GM only — computed from the
    chat log the GM's client actually has (hadUnconfirmedAttackBefore,
    rolls.mjs). No `hidden` attribute here: Foundry strips it from stored
    message content. --}}
  {{#if canConfirm}}
    <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--warning" data-hg-unconfirmed-warning>
      {{localize 'HEROES_GLORY.Roll.UnconfirmedWarning'}}
    </p>
  {{/if}}

  <p class="heroes-glory-chat-card__damage">
    {{#if (eq headlineOutcome 'defeatFailed')}}
      {{localize 'HEROES_GLORY.Roll.HeadlineDefeatFailed' hit=(localize hit.labelKey)}}
    {{else}}
      {{localize hit.labelKey}}
    {{/if}}
    ·
    {{#if damageKnown}}
      {{#if confirmed}}
        {{localize 'HEROES_GLORY.Roll.DamageApplied' damage=damage}}
      {{else}}
        {{localize 'HEROES_GLORY.Roll.DamagePending' damage=damage}}
      {{/if}}
    {{else}}
      {{localize 'HEROES_GLORY.Roll.DamagePotential' damage=potentialDamage}}
    {{/if}}
  </p>

  {{#if hit.epic}}
    <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.EpicRetreat'}}</p>
  {{/if}}

  {{#if location}}
    <p class="heroes-glory-chat-card__line">
      {{localize location.labelKey}} —
      {{#if location.protectingArmorName}}
        {{localize location.protectedKey armor=location.protectingArmorName}}
      {{else}}
        {{localize location.effectKey}}
      {{/if}}
    </p>
  {{/if}}

  {{#if destroyedArmorNames}}
    <p class="heroes-glory-chat-card__line">
      {{#if confirmed}}
        {{localize 'HEROES_GLORY.Roll.ArmorDestroyedApplied' armor=destroyedArmorNames}}
      {{else}}
        {{localize 'HEROES_GLORY.Roll.ArmorDestroyedPending' armor=destroyedArmorNames}}
      {{/if}}
    </p>
  {{/if}}

  {{!-- Details: collapsed by default. --}}
  <div class="heroes-glory-chat-card__details">
    {{#if weaponName}}
      <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.Weapon' weapon=weaponName}}</p>
    {{/if}}
    {{#if (eq attackRange 'ranged')}}
      <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.AttackRanged'}}</p>
    {{else if (eq attackRange 'melee')}}
      <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.AttackMelee'}}</p>
    {{/if}}
    {{#if series}}
      <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.SeriesLine' index=series.index total=series.total}}</p>
    {{/if}}

    <p class="heroes-glory-chat-card__line">
      {{#if hit.previousDie}}
        <s class="heroes-glory-chat-card__reroll-old">{{localize 'HEROES_GLORY.Roll.RerolledFrom' die=hit.previousDie}}</s>
      {{/if}}
      {{localize 'HEROES_GLORY.Roll.HitResult' die=hit.die result=(localize hit.labelKey) multiplier=hit.multiplier}}
      <button type="button" class="heroes-glory-chat-card__reroll-btn" data-action="hg-reroll-luck"
        data-actor-id="{{actorId}}" data-slot="hit" title="{{localize 'HEROES_GLORY.Roll.RerollLuckHint'}}">
        <i class="fa-solid fa-arrows-rotate"></i>
      </button>
    </p>
    {{#if hitModifierLine}}
      <p class="heroes-glory-chat-card__line">{{hitModifierLine}}</p>
    {{/if}}
    {{#if adjacencyUnknown}}
      <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.AdjacencyUnknown'}}</p>
    {{/if}}

    {{#if contestedDefeat}}
      {{#if contestedDefeat.known}}
        <p class="heroes-glory-chat-card__line">
          {{#if defeat.previousDie}}
            <s class="heroes-glory-chat-card__reroll-old">{{localize 'HEROES_GLORY.Roll.RerolledFrom' die=defeat.previousDie}}</s>
          {{/if}}
          {{localize 'HEROES_GLORY.Roll.DefeatContested' die=contestedDefeat.die attack=attackerAttack attackerTotal=contestedDefeat.attackerTotal targetDie=contestedDefeat.targetDie defense=targetDefense targetTotal=contestedDefeat.targetTotal}}
          —
          {{#if contestedDefeat.success}}{{localize 'HEROES_GLORY.Roll.DefeatSuccess'}}{{else}}{{localize 'HEROES_GLORY.Roll.DefeatFail'}}{{/if}}
          <button type="button" class="heroes-glory-chat-card__reroll-btn" data-action="hg-reroll-luck"
            data-actor-id="{{actorId}}" data-slot="defeat" title="{{localize 'HEROES_GLORY.Roll.RerollLuckHint'}}">
            <i class="fa-solid fa-arrows-rotate"></i>
          </button>
        </p>
      {{else}}
        <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.DefeatUnknown'}}</p>
      {{/if}}
    {{else if defeat.known}}
      {{#if defeat.auto}}
        <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.DefeatAuto'}}</p>
      {{else}}
        <p class="heroes-glory-chat-card__line">
          {{#if defeat.previousDie}}
            <s class="heroes-glory-chat-card__reroll-old">{{localize 'HEROES_GLORY.Roll.RerolledFrom' die=defeat.previousDie}}</s>
          {{/if}}
          {{localize 'HEROES_GLORY.Roll.DefeatThreshold' die=defeat.die threshold=defeat.threshold}}
          —
          {{#if defeat.success}}{{localize 'HEROES_GLORY.Roll.DefeatSuccess'}}{{else}}{{localize 'HEROES_GLORY.Roll.DefeatFail'}}{{/if}}
          <button type="button" class="heroes-glory-chat-card__reroll-btn" data-action="hg-reroll-luck"
            data-actor-id="{{actorId}}" data-slot="defeat" title="{{localize 'HEROES_GLORY.Roll.RerollLuckHint'}}">
            <i class="fa-solid fa-arrows-rotate"></i>
          </button>
        </p>
      {{/if}}
    {{else}}
      <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.DefeatUnknown'}}</p>
    {{/if}}

    {{#if (gt stateMultiplier 1)}}
      <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">
        {{localize 'HEROES_GLORY.Roll.StateMultiplierNote' multiplier=stateMultiplier}}
      </p>
    {{/if}}

    {{!-- §5.5: protectingArmorNames is already '' when a level-3 zone
      match zeroed the damage — see buildAttackContext's own comment, this
      is not the same condition as armorItemMultiplier < 1. --}}
    {{#if protectingArmorNames}}
      <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">
        {{localize 'HEROES_GLORY.Roll.ArmorItemNote' armor=protectingArmorNames}}
      </p>
    {{/if}}

    {{#if hit.epic}}
      {{#if hasEpicTable}}
        {{#if epicRow}}
          <p class="heroes-glory-chat-card__line">{{epicRow}}</p>
        {{/if}}
      {{else}}
        <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize (ifThen (eq attackRange 'ranged') 'HEROES_GLORY.Roll.EpicNoTableRanged' 'HEROES_GLORY.Roll.EpicNoTable')}}</p>
      {{/if}}
      {{#if severe}}
        <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Roll.EpicSevere'}}</p>
      {{/if}}
    {{/if}}
  </div>

  {{#if canConfirm}}
    <button type="button" class="heroes-glory-chat-card__confirm-btn" data-action="hg-confirm-attack"
      title="{{localize 'HEROES_GLORY.Roll.ConfirmHint'}}">
      {{localize 'HEROES_GLORY.Roll.ConfirmButton'}}
    </button>
  {{else if confirmed}}
    <p class="heroes-glory-chat-card__line heroes-glory-chat-card__applied">{{localize 'HEROES_GLORY.Roll.Applied'}}</p>
  {{/if}}

  {{!-- §11 attack series: shown to the attacker's owners and the GM only
    (chat.mjs). --}}
  {{#if nextAttack.show}}
    <button type="button" class="heroes-glory-chat-card__confirm-btn" data-action="hg-next-attack" data-actor-id="{{actorId}}">
      {{localize 'HEROES_GLORY.Roll.NextAttack' index=nextAttack.next total=series.total}}
    </button>
  {{else if nextAttack.stoppedByTarget}}
    <p class="heroes-glory-chat-card__line heroes-glory-chat-card__line--muted">{{localize 'HEROES_GLORY.Roll.SeriesStopped'}}</p>
  {{/if}}
</div>
