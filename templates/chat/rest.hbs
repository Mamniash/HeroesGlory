<div class="heroes-glory-chat-card heroes-glory-chat-card--rest">
  <h3 class="heroes-glory-chat-card__title">{{localize 'HEROES_GLORY.Rest.CardTitle' actor=actorName}}</h3>
  <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Rest.HealthLine' before=health.before after=health.after max=health.max}}</p>
  <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Rest.ManaLine' before=mana.before after=mana.after max=mana.max}}</p>
  <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Rest.LuckLine' before=luck.before after=luck.after}}</p>
  {{#if wasUnrested}}
    <p class="heroes-glory-chat-card__line">{{localize 'HEROES_GLORY.Rest.UnrestedLifted'}}</p>
  {{/if}}
</div>
