<div class="heroes-glory-chat-card heroes-glory-chat-card--levelup-secondary">
  <h3 class="heroes-glory-chat-card__title">{{localize 'HEROES_GLORY.Roll.LevelUpSecondarySkillTitle' actor=actorName}}</h3>
  <p class="heroes-glory-chat-card__line">
    {{#if rerollCount}}
      {{localize 'HEROES_GLORY.Roll.LevelUpSecondarySkillResultRerolled' die=die skill=(localize skillLabelKey) count=rerollCount}}
    {{else}}
      {{localize 'HEROES_GLORY.Roll.LevelUpSecondarySkillResult' die=die skill=(localize skillLabelKey)}}
    {{/if}}
  </p>
</div>
