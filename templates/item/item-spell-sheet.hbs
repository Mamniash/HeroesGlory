{{#> "systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
<section class="hg-item__body">
  <div class="hg-item__row">
    <div class="hg-item__field--grow">
      {{> "systems/heroes-glory/templates/item/parts/hg-select.hbs" name="system.school"
        choices=config.schools value=system.school label=(localize 'HEROES_GLORY.Spell.School')}}
    </div>
    <label class="hg-item__field hg-item__field--damage">
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Spell.Level'}}</span>
      <input class="hg-item__input" type="number" name="system.level" value="{{system.level}}" min="1" max="5" step="1">
    </label>
    <label class="hg-item__field hg-item__field--damage">
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Spell.Range'}}</span>
      <input class="hg-item__input" type="number" name="system.range" value="{{system.range}}" min="0" step="1">
    </label>
  </div>

  {{!-- §6.3: all four mastery variants, one under another (readable in a
    narrow window): the variant's name, then its description and mana cost. --}}
  {{#each variantRows}}
    <div class="hg-item__section-title">{{localize label}}</div>
    {{!-- Labels on one line, fields on the next: a two-line label
      («Стоимость Маны») can't push its field below the description's. --}}
    <div class="hg-item__pair">
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Spell.Description'}}</span>
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Spell.ManaCost'}}</span>
      <textarea class="hg-item__input hg-item__textarea" name="system.variants.{{key}}.description" rows="1"
        aria-label="{{localize 'HEROES_GLORY.Spell.Description'}}">{{description}}</textarea>
      <input class="hg-item__input" type="number" name="system.variants.{{key}}.manaCost" value="{{manaCost}}" min="0" step="1"
        aria-label="{{localize 'HEROES_GLORY.Spell.ManaCost'}}">
    </div>
  {{/each}}
</section>
{{/"systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
