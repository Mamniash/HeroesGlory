{{#> "systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
<section class="hg-item__body">
  {{!-- Worn or not is decided by the hero's paperdoll, not here — the
    sheet has no «Экипировано» checkbox (system.equipped stays in the data). --}}
  {{> "systems/heroes-glory/templates/item/parts/hg-weapon-fields.hbs"}}

  <label class="hg-item__field">
    <span class="hg-item__label">{{localize 'HEROES_GLORY.Weapon.Source'}}</span>
    <input class="hg-item__input" type="text" name="system.source" value="{{system.source}}">
  </label>

  {{!-- Folded on every opening; the title works in read-only mode too
    (not a form control, so a locked sheet doesn't disable it). --}}
  <div class="hg-item__section{{#if openSections.epic}} is-expanded{{/if}}" data-section="epic">
    <div class="hg-item__section-title hg-item__toggle" data-action="toggleSection" role="button" tabindex="0"
      aria-expanded="{{#if openSections.epic}}true{{else}}false{{/if}}">
      <span class="hg-item__toggle-arrow"></span>
      <span>{{localize 'HEROES_GLORY.Item.EpicTable'}}</span>
    </div>
    <div class="hg-item__section-body">
      {{#each system.epicTable}}
        <label class="hg-item__field">
          <span class="hg-item__label">{{localize 'HEROES_GLORY.Item.EpicRow'}} {{inc @index}}</span>
          <textarea class="hg-item__input hg-item__textarea" name="system.epicTable.{{@index}}" rows="1">{{this}}</textarea>
        </label>
      {{/each}}
    </div>
  </div>
</section>
{{/"systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
