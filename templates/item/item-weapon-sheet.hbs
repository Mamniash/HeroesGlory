{{#> "systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
<section class="hg-item__body">
  {{!-- Worn or not is decided by the hero's paperdoll, not here — the
    sheet has no «Экипировано» checkbox (system.equipped stays in the data). --}}
  <div class="hg-item__row">
    <label class="hg-item__field hg-item__field--grow">
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Weapon.Type'}}</span>
      <select class="hg-item__input" name="system.weaponType">
        {{selectOptions config.weaponTypes selected=system.weaponType localize=true}}
      </select>
    </label>

    <label class="hg-item__field hg-item__field--damage">
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Weapon.Damage'}}</span>
      <input class="hg-item__input" type="number" name="system.damage" value="{{system.damage}}" min="2" max="100" step="1">
    </label>

    <label class="hg-item__checkbox">
      <input class="hg-item__checkbox-box" type="checkbox" name="system.twoHanded" {{checked system.twoHanded}}>
      <span class="hg-item__label">{{localize 'HEROES_GLORY.Weapon.TwoHanded'}}</span>
    </label>
  </div>

  <label class="hg-item__field">
    <span class="hg-item__label">{{localize 'HEROES_GLORY.Weapon.Source'}}</span>
    <input class="hg-item__input" type="text" name="system.source" value="{{system.source}}">
  </label>

  {{!-- Collapsed by default; the ▸/▾ title works in read-only mode too
    (not a form control, so the locked sheet doesn't disable it). --}}
  <div class="hg-item__section{{#if epicTableExpanded}} is-expanded{{/if}}">
    <div class="hg-item__section-title hg-item__toggle" data-action="toggleEpicTable">{{localize 'HEROES_GLORY.Item.EpicTable'}}</div>
    <div class="hg-item__section-body">
      {{#each system.epicTable}}
        <label class="hg-item__field">
          <span class="hg-item__label">{{localize 'HEROES_GLORY.Item.EpicRow'}} {{inc @index}}</span>
          <textarea class="hg-item__input hg-item__textarea" name="system.epicTable.{{@index}}" rows="1">{{this}}</textarea>
        </label>
      {{/each}}
    </div>
  </div>
</section>
{{/"systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
