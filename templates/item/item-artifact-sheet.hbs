{{#> "systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
<section class="hg-item__body">
  {{!-- Worn or not is decided by the hero's paperdoll — no «Экипировано»
    here (system.equipped stays in the data). --}}
  <div class="hg-item__row">
    <div class="hg-item__field--grow">
      {{> "systems/heroes-glory/templates/item/parts/hg-select.hbs" name="system.artifactType"
        choices=config.artifactTypes value=system.artifactType label=(localize 'HEROES_GLORY.Artifact.Type')}}
    </div>
    {{!-- §5.5/§8.2: armor level — epic mitigation; shield level — +level
      to Defense. Meaningless for the other four types. --}}
    {{#if hasLevel}}
      <label class="hg-item__field hg-item__field--damage">
        <span class="hg-item__label">{{localize 'HEROES_GLORY.Artifact.Level'}}</span>
        <input class="hg-item__input" type="number" name="system.level" value="{{system.level}}" min="1" max="5" step="1">
      </label>
    {{/if}}
  </div>

  {{#if isWeapon}}
    {{> "systems/heroes-glory/templates/item/parts/hg-weapon-fields.hbs"}}
  {{/if}}

  <label class="hg-item__field">
    <span class="hg-item__label">{{localize 'HEROES_GLORY.Artifact.Bonus'}}</span>
    <textarea class="hg-item__input hg-item__textarea" name="system.bonus" rows="1">{{system.bonus}}</textarea>
  </label>

  <div class="hg-item__section-title">{{localize 'HEROES_GLORY.Artifact.Slots'}}</div>
  {{!-- Mini-paperdoll: a cell per hero-sheet slot, marked where the hero's
    paperdoll accepts this artifact. Rings and «прочее» toggle as one group;
    the book slot and 17–19 are locked. An enchanted weapon's slot follows
    its weapon type, so its doll only shows it — no clicks. --}}
  <div class="hg-doll-row">
    <div class="hg-doll" data-color="{{panelColor}}">
      {{#each dollCells}}
        <div class="hg-doll__cell hg-doll__cell--{{slot}}{{#if on}} is-on{{/if}}{{#if locked}} is-locked{{/if}}"
          data-slot="{{slot}}"
          {{#if clickable}}role="button" tabindex="0" data-action="toggleSlot" aria-pressed="{{#if on}}true{{else}}false{{/if}}" aria-label="{{name}}"{{/if}}></div>
      {{/each}}
    </div>
  </div>

  <div class="hg-item__section-title">{{localize 'HEROES_GLORY.Artifact.Modifiers'}}</div>
  <div class="hg-item__list">
    {{#each modifierRows}}
      <div class="hg-item__list-row">
        <div class="hg-item__list-grow">
          {{> "systems/heroes-glory/templates/item/parts/hg-select.hbs" bare=true name=(concat "system.modifiers." index ".stat")
            choices=../config.artifactModifierStats value=stat label=(localize 'HEROES_GLORY.Artifact.Modifiers')}}
        </div>
        <input type="hidden" name="system.modifiers.{{index}}.mode" value="{{mode}}">
        {{!-- Signed text («+2», «-3») — the model's NumberField reads it. --}}
        <input class="hg-item__input hg-item__signed" type="text" inputmode="numeric" name="system.modifiers.{{index}}.value" value="{{shown}}">
        <button type="button" class="hg-item__sprite-button hg-item__delete" data-action="deleteModifier" data-index="{{index}}"
          aria-label="{{localize 'HEROES_GLORY.Artifact.DeleteModifier'}}"></button>
      </div>
    {{/each}}
    {{!-- New modifier: pick a characteristic in the empty row (no name on
      the select — artifact-sheet.mjs adds the row itself). --}}
    <div class="hg-item__list-row">
      <div class="hg-item__list-grow">
        {{> "systems/heroes-glory/templates/item/parts/hg-select.hbs" bare=true role="add-modifier" value=""
          choices=config.artifactModifierStats placeholder=(localize 'HEROES_GLORY.Artifact.AddModifier')}}
      </div>
    </div>
  </div>
</section>
{{/"systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
