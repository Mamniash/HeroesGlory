{{#> "systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
<section class="hg-item__body">
  {{!-- The skill itself is chosen in the header (headerSelect); the item's
    name and image follow it (documents/item.mjs). The three tiers, one
    under another like a spell's variants: the tier's name, then its
    effect. The owned tier is marked; where the sheet is editable a click
    on another tier block makes it the owned one. --}}
  {{#each tierRows}}
    <div class="hg-item__variant{{#if active}} is-active{{/if}}"
      {{#if ../editable}}{{#unless active}}data-action="setTier" data-tier="{{key}}"{{/unless}}{{/if}}>
      <div class="hg-item__section-title">{{localize label}}</div>
      <textarea class="hg-item__input hg-item__textarea" name="system.effects.{{key}}" rows="1"
        aria-label="{{localize effectLabel}}">{{text}}</textarea>
    </div>
  {{/each}}
</section>
{{/"systems/heroes-glory/templates/item/parts/hg-item-frame.hbs"}}
