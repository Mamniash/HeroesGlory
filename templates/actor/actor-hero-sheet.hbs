<div class="hero-paperdoll-wrapper">
<div class="hero-paperdoll" data-panel-color="{{system.panelColor}}">

  <img class="hero-paperdoll__slot hero-paperdoll__slot--portrait" src="{{actor.img}}" alt="{{actor.name}}"
    data-action="editImage" data-edit="img" role="button" tabindex="0"
    aria-label="{{localize 'HEROES_GLORY.Actor.ChangeImage'}}">

  <div class="hero-paperdoll__slot hero-paperdoll__slot--name">
    <input class="hero-paperdoll__name-input" type="text" name="name" value="{{actor.name}}"
      placeholder="{{localize 'HEROES_GLORY.Actor.NamePlaceholder'}}">
    <p class="hero-paperdoll__name-line">{{localize raceLabel}} — {{localize classLabel}}</p>
    <p class="hero-paperdoll__name-line">{{localize factionLabel}}</p>
  </div>

  {{!-- ==================== Primary skills: labels / icons / values ==================== --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--text_1 hero-paperdoll__primary-row">
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="attack"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.Attack'}}</span>
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="defense"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.Defense'}}</span>
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="magicPower"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.MagicPower'}}</span>
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="knowledge"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.Knowledge'}}</span>
  </div>

  <img class="hero-paperdoll__slot hero-paperdoll__slot--attack" src="{{icons.attack}}" alt=""
    data-tooltip-trigger="skill-attack">
  <img class="hero-paperdoll__slot hero-paperdoll__slot--defence" src="{{icons.defense}}" alt=""
    data-tooltip-trigger="skill-defense">
  <img class="hero-paperdoll__slot hero-paperdoll__slot--knowledge" src="{{icons.knowledge}}" alt=""
    data-tooltip-trigger="skill-knowledge">
  <img class="hero-paperdoll__slot hero-paperdoll__slot--witchcraft" src="{{icons.magicPower}}" alt=""
    data-tooltip-trigger="skill-magicPower">

  <div class="hero-paperdoll__slot hero-paperdoll__slot--text_2 hero-paperdoll__primary-row">
    <span class="hero-paperdoll__primary-cell">
      <input class="hero-paperdoll__primary-value" type="number" name="system.attack" value="{{source.attack}}" min="0">
    </span>
    <span class="hero-paperdoll__primary-cell">
      <input class="hero-paperdoll__primary-value" type="number" name="system.defense" value="{{source.defense}}" min="0">
    </span>
    <span class="hero-paperdoll__primary-cell">
      <input class="hero-paperdoll__primary-value" type="number" name="system.magicPower" value="{{source.magicPower}}" min="0">
    </span>
    <span class="hero-paperdoll__primary-cell">
      <input class="hero-paperdoll__primary-value" type="number" name="system.knowledge" value="{{source.knowledge}}" min="0">
    </span>
  </div>

  {{!-- ==================== Health / Experience / Mana ==================== --}}
  <img class="hero-paperdoll__slot hero-paperdoll__slot--health_name" src="{{icons.health}}" alt=""
    data-tooltip-trigger="health">
  <div class="hero-paperdoll__slot hero-paperdoll__slot--health_desc">
    <input type="number" name="system.health.value" value="{{system.health.value}}" min="0">
    <span class="hero-paperdoll__value-sep">/</span>
    <span class="hero-paperdoll__value-max">{{system.health.max}}</span>
  </div>

  <img class="hero-paperdoll__slot hero-paperdoll__slot--experience_name" src="{{icons.experience}}" alt=""
    data-tooltip-trigger="experience">
  <div class="hero-paperdoll__slot hero-paperdoll__slot--experience_desc">
    <input type="number" name="system.experience" value="{{system.experience}}" min="0">
  </div>

  <img class="hero-paperdoll__slot hero-paperdoll__slot--mana_name" src="{{icons.mana}}" alt=""
    data-tooltip-trigger="mana">
  <div class="hero-paperdoll__slot hero-paperdoll__slot--mana_desc">
    <input type="number" name="system.mana.value" value="{{system.mana.value}}" min="0">
    <span class="hero-paperdoll__value-sep">/</span>
    <span class="hero-paperdoll__value-max">{{system.mana.max}}</span>
  </div>

  {{!-- ==================== Morale / Luck (read display — editable in the details fallback) ==================== --}}
  <img class="hero-paperdoll__slot hero-paperdoll__slot--morale" src="{{icons.morale}}" alt=""
    data-tooltip-trigger="morale">
  <img class="hero-paperdoll__slot hero-paperdoll__slot--luck" src="{{icons.luck}}" alt=""
    data-tooltip-trigger="luck">

  {{!-- ==================== Secondary skills (8 slots) ==================== --}}
  {{#each secondarySkillSlots}}
    <div class="hero-paperdoll__slot hero-paperdoll__slot--skill_name_{{inc @index}}">
      {{#if this}}
        <img class="hero-paperdoll__icon-img" src="{{this.icon}}" data-item-id="{{this.item.id}}"
          data-action="useSkill" title="{{localize 'HEROES_GLORY.Roll.SkillUseHint'}}"
          data-tooltip-trigger="secskill-{{inc @index}}">
        <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.item.id}}"
          title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
        <template class="hg-tooltip-tpl" data-tooltip-key="secskill-{{inc @index}}">
          <img class="hg-tooltip__icon" src="{{this.iconLarge}}" width="82" height="93" alt="">
          <p class="hg-tooltip__title">{{localize this.skillLabel}} — {{localize this.tierLabel}}</p>
          <p>{{this.effectText}}</p>
        </template>
      {{/if}}
    </div>
    <div class="hero-paperdoll__slot hero-paperdoll__slot--skill_desc_{{inc @index}}">
      {{#if this}}<span>{{localize this.skillLabel}} — {{localize this.tierLabel}}</span>{{/if}}
    </div>
  {{/each}}

  {{!-- ==================== Left-half tooltip content (module/helpers/tooltip.mjs) ==================== --}}
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-attack">
    <img class="hg-tooltip__icon" src="{{icons.attackLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Attack'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.attack}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.attack}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-defense">
    <img class="hg-tooltip__icon" src="{{icons.defenseLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Defense'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.defense}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.defense}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-magicPower">
    <img class="hg-tooltip__icon" src="{{icons.magicPowerLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.MagicPower'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.magicPower}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.magicPower}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-knowledge">
    <img class="hg-tooltip__icon" src="{{icons.knowledgeLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Knowledge'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.knowledge}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.knowledge}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="health">
    <img class="hg-tooltip__icon" src="{{icons.healthLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Health'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.CurrentOfMax' current=system.health.value max=system.health.max}}</p>
    {{#if system.wounds}}
      <p>{{localize 'HEROES_GLORY.Tooltip.HealthWoundBreakdown' base=system.health.base wounds=system.wounds afterWounds=healthAfterWounds}}</p>
      {{#unless (eq healthAfterWounds system.health.max)}}
        <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.health.max}}</p>
      {{/unless}}
    {{/if}}
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="experience">
    <img class="hg-tooltip__icon" src="{{icons.experienceLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Experience'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.ExperienceCurrent' value=system.experience}}</p>
    {{#if experienceToNext}}
      <p>{{localize 'HEROES_GLORY.Tooltip.ExperienceToNext' value=experienceToNext}}</p>
    {{/if}}
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="mana">
    <img class="hg-tooltip__icon" src="{{icons.manaLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Mana'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.CurrentOfMax' current=system.mana.value max=system.mana.max}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.ManaFormula' knowledge=system.knowledge multiplier=manaMultiplier product=manaBeforeWounds}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="morale">
    <img class="hg-tooltip__icon" src="{{icons.moraleLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Morale'}}: {{system.morale}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.MoralePositiveHint'}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="luck">
    <img class="hg-tooltip__icon" src="{{icons.luckLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Luck'}}: {{system.luck}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.LuckHint'}}</p>
  </template>

  {{!-- ==================== Paperdoll (19 slots) ==================== --}}
  {{#each paperdollSlots}}
    <div class="hero-paperdoll__slot hero-paperdoll__slot--paperdoll-{{this.index}}" data-slot="{{this.index}}">
      {{#if this.item}}
        <img class="draggable hero-paperdoll__icon-img" src="{{this.item.img}}" data-item-id="{{this.item.id}}"
          data-action="openItem" data-tooltip="{{this.item.name}}">
        <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.item.id}}"
          title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
      {{/if}}
    </div>
  {{/each}}

  {{!-- ==================== Backpack (5 visible of a paged list) + arrows ==================== --}}
  {{#each backpackPageItems}}
    <div class="hero-paperdoll__slot hero-paperdoll__slot--backpack-{{inc @index}}" data-slot="backpack">
      {{#if this}}
        <img class="draggable hero-paperdoll__icon-img" src="{{this.img}}" data-item-id="{{this.id}}"
          data-action="openItem" data-tooltip="{{this.name}}">
        <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.id}}"
          title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
      {{/if}}
    </div>
  {{/each}}

  <button type="button" class="hero-paperdoll__slot hero-paperdoll__slot--arrow_left" data-action="backpackPage" data-direction="prev"
    {{#unless backpackPage}}disabled{{/unless}} aria-label="{{localize 'HEROES_GLORY.Hero.BackpackPrevHint'}}"></button>
  <button type="button" class="hero-paperdoll__slot hero-paperdoll__slot--arrow_right" data-action="backpackPage" data-direction="next"
    {{#if (eq backpackPage backpackMaxPage)}}disabled{{/if}} aria-label="{{localize 'HEROES_GLORY.Hero.BackpackNextHint'}}"></button>

</div>
{{!-- /.hero-paperdoll — everything below is a sibling, not a descendant,
     so the leather background (background-size: 100% 100%) never
     stretches to cover this section's height when <details> is open. --}}

  {{!-- ====================================================================
       Everything below is NOT on the HOMM3 mockup. Per the approved plan,
       it stays fully functional (same fields/actions as before this
       rework) but collapsed out of the primary view. ==================== --}}
  <details class="hero-paperdoll__more">
    <summary>{{localize 'HEROES_GLORY.Hero.MoreDetails'}}</summary>

    <div class="grid grid-3col">
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Specialization'}}</span>
        <input type="text" name="system.specialization" value="{{system.specialization}}">
      </label>
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">
          {{localize 'HEROES_GLORY.Hero.Morale'}}
          {{#unless (eq source.morale system.morale)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.morale}}</span>{{/unless}}
        </span>
        <input type="number" name="system.morale" value="{{source.morale}}">
      </label>
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">
          {{localize 'HEROES_GLORY.Hero.Luck'}}
          {{#unless (eq source.luck system.luck)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.luck}}</span>{{/unless}}
        </span>
        <input type="number" name="system.luck" value="{{source.luck}}" min="-3" max="3">
      </label>
    </div>

    {{#if (or (gt system.morale 0) (and isGM (lt system.morale 0)))}}
      <div class="hero-sheet__morale-actions">
        {{#if (gt system.morale 0)}}
          <button type="button" class="hero-sheet__action-button" data-action="rollMoraleCheck" data-variant="positive"
            {{#unless moraleRemaining}}disabled{{/unless}}
            title="{{#if moraleRemaining}}{{localize 'HEROES_GLORY.Roll.MoraleHint'}}{{else}}{{localize 'HEROES_GLORY.Roll.MoraleExhausted'}}{{/if}}">
            <i class="fa-solid fa-dice-d6"></i> {{localize 'HEROES_GLORY.Roll.MoraleCheck'}} ({{moraleRemaining}})
          </button>
        {{/if}}
        {{#if (and isGM (lt system.morale 0))}}
          <button type="button" class="hero-sheet__action-button" data-action="rollMoraleCheck" data-variant="negative"
            {{#unless moraleRemaining}}disabled{{/unless}}
            title="{{#if moraleRemaining}}{{localize 'HEROES_GLORY.Roll.MoraleSkipHint'}}{{else}}{{localize 'HEROES_GLORY.Roll.MoraleExhausted'}}{{/if}}">
            <i class="fa-solid fa-dice-d6"></i> {{localize 'HEROES_GLORY.Roll.MoraleSkipCheck'}} ({{moraleRemaining}})
          </button>
        {{/if}}
      </div>
    {{/if}}

    <div class="grid grid-2col">
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.HealthBase'}}</span>
        <input type="number" name="system.health.base" value="{{system.health.base}}" min="0">
      </label>
      <div class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Wounds'}}</span>
        <div class="hero-sheet__wounds-counter">
          <button type="button" class="hero-sheet__icon-button" data-action="adjustWounds" data-delta="-1"
            title="{{localize 'HEROES_GLORY.Hero.WoundsRemoveHint'}}"><i class="fa-solid fa-minus"></i></button>
          <span class="hero-sheet__wounds-value">{{system.wounds}}</span>
          <button type="button" class="hero-sheet__icon-button" data-action="adjustWounds" data-delta="1"
            title="{{localize 'HEROES_GLORY.Hero.WoundsAddHint'}}"><i class="fa-solid fa-plus"></i></button>
        </div>
      </div>
    </div>

    {{#if (or healthDepleted manaDepleted)}}
      <p class="hero-sheet__warning">
        {{#if healthDepleted}}{{localize 'HEROES_GLORY.Hero.HealthDepletedWarning'}}{{/if}}
        {{#if manaDepleted}}{{localize 'HEROES_GLORY.Hero.ManaDepletedWarning'}}{{/if}}
      </p>
    {{/if}}

    {{#if (and isGM isIncapacitated)}}
      <div class="hero-sheet__morale-actions">
        <button type="button" class="hero-sheet__action-button" data-action="postBattleCheck" data-variant="roll"
          title="{{localize 'HEROES_GLORY.Roll.PostBattleCheckHint'}}">
          <i class="fa-solid fa-dice-d20"></i> {{localize 'HEROES_GLORY.Roll.PostBattleCheck'}}
        </button>
        <button type="button" class="hero-sheet__action-button" data-action="postBattleCheck" data-variant="help"
          title="{{localize 'HEROES_GLORY.Roll.PostBattleHelpHint'}}">
          <i class="fa-solid fa-hand-holding-medical"></i> {{localize 'HEROES_GLORY.Roll.PostBattleHelp'}}
        </button>
      </div>
    {{/if}}

    <div class="grid grid-4col">
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">
          {{localize 'HEROES_GLORY.Hero.Speed'}}
          {{#unless (eq source.speed system.speed)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.speed}}</span>{{/unless}}
        </span>
        <input type="number" name="system.speed" value="{{source.speed}}" min="0">
      </label>
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Vision'}}</span>
        <select name="system.vision">
          {{selectOptions config.visionTypes selected=system.vision localize=true}}
        </select>
      </label>
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Gold'}}</span>
        <input type="number" name="system.gold" value="{{system.gold}}" min="0">
      </label>
      <label class="actor-sheet__field actor-sheet__field--checkbox">
        <input type="checkbox" name="system.hasSpellbook" {{checked system.hasSpellbook}}>
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.HasSpellbook'}}</span>
      </label>
    </div>

    <div class="grid grid-3col">
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Race'}}</span>
        <select name="system.race">
          {{selectOptions config.races selected=system.race localize=true}}
        </select>
      </label>
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Faction'}}</span>
        <select name="system.faction">
          {{selectOptions config.factions selected=system.faction localize=true}}
        </select>
      </label>
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.Class'}}</span>
        <select name="system.heroClass">
          {{selectOptions config.classes selected=system.heroClass localize=true}}
        </select>
      </label>
    </div>

    <label class="actor-sheet__field">
      <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Hero.PanelColor'}}</span>
      <select name="system.panelColor">
        {{selectOptions config.panelColors selected=system.panelColor localize=true}}
      </select>
    </label>

    <div class="hero-sheet__section">
      <h3 class="hero-sheet__section-title">{{localize 'HEROES_GLORY.Hero.Spells'}}</h3>
      {{#if system.hasSpellbook}}
        <ul class="hero-sheet__item-list">
          {{#each spells}}
            <li class="hero-sheet__item-slot hero-sheet__item-slot--filled">
              <span class="hero-sheet__item-slot-value" data-action="openItem" data-item-id="{{this.id}}">{{this.name}}</span>
              <span class="hero-sheet__item-actions">
                <button type="button" class="hero-sheet__icon-button" data-action="castSpell" data-item-id="{{this.id}}"
                  title="{{localize 'HEROES_GLORY.Roll.CastHint'}}"><i class="fa-solid fa-dice-d20"></i></button>
                <button type="button" class="hero-sheet__icon-button" data-action="deleteItem" data-item-id="{{this.id}}"
                  title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}"><i class="fa-solid fa-trash"></i></button>
              </span>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="hero-sheet__empty-note">{{localize 'HEROES_GLORY.Hero.NoSpellbook'}}</p>
      {{/if}}
    </div>
  </details>

</div>
{{! /.hero-paperdoll-wrapper }}

