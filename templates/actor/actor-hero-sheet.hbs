<div class="hero-paperdoll-wrapper">
{{#if spellbookOpen}}
<div class="hero-spellbook" data-panel-color="{{effectivePanelColor}}">

  {{!-- ==================== 12 spell slots (1-6 left page, 7-12 right page) ==================== --}}
  {{#each spellbookSlots}}
    <div class="hero-spellbook__slot hero-spellbook__slot--icon_{{inc @index}}">
      {{#if this}}
        <img class="hero-spellbook__icon-img" src="{{this.iconSrc}}" data-item-id="{{this.item.id}}"
          data-action="castSpell" data-tooltip-trigger="spell-{{this.item.id}}">
        {{#if this.frame}}
          <img class="hero-spellbook__frame-img" src="{{this.frame}}" alt="">
        {{/if}}
        <template class="hg-tooltip-tpl" data-tooltip-key="spell-{{this.item.id}}">
          <img class="hg-tooltip__icon" src="{{this.iconSrc}}" width="78" height="65" alt="">
          <p class="hg-tooltip__title">{{this.item.name}}</p>
          <p>{{localize 'HEROES_GLORY.Spell.Level'}}: {{this.item.system.level}}</p>
          <p>{{localize 'HEROES_GLORY.Spell.School'}}: {{localize this.schoolLabelKey}}</p>
          <p>{{localize this.variantLabelKey}}</p>
          <p>{{localize 'HEROES_GLORY.Roll.ManaCost' cost=this.variantData.manaCost}}</p>
          <p>{{this.variantData.description}}</p>
          {{#if this.wisdomLockLine}}<p>{{this.wisdomLockLine}}</p>{{/if}}
          {{#if this.ambiguous}}
            {{!-- §6.2/§11: Универсальные, 2+ schools tied at the same max
              tier — school/variant/cost above are a PREVIEW (first tied
              school by SCHOOL_ORDER), not yet final; casting still opens
              a picker to ask which school gets credit. --}}
            <p>{{localize 'HEROES_GLORY.Spellbook.SchoolPickPending'}}</p>
          {{/if}}
        </template>
      {{/if}}
    </div>
    <div class="hero-spellbook__slot hero-spellbook__slot--text_{{inc @index}}">
      {{!-- {{#if this.variantData.manaCost}} takes the "no cost" (—) branch for
        BOTH an honest 0 and an unset value — deliberate, not a rendering bug:
        rules.md has real spells with no mana cost (e.g. Стена огня), and a
        dash reads correctly for those; nothing in this book currently has a
        genuine 0 that should print as "0". --}}
      {{#if this}}<span class="hero-spellbook__spell-name">{{this.item.name}}</span><span class="hero-spellbook__spell-meta">{{#if this.variantData.manaCost}}{{localize 'HEROES_GLORY.Spellbook.SpellMeta' level=this.item.system.level cost=this.variantData.manaCost}}{{else}}{{localize 'HEROES_GLORY.Spellbook.SpellMetaNoCost' level=this.item.system.level}}{{/if}}</span>{{/if}}
    </div>
  {{/each}}

  {{!-- ==================== Page-turn corners (assets/ui/speltrn{l,r}_rgba.png,
    keyed transparent — see scripts/key_bg.py; native aspect ratio) — not
    rendered at all when there's nowhere to turn, rather than shown disabled;
    the slot's own box still reserves no layout space either way (both
    corners are `position: absolute`, not part of any flex/grid flow that a
    missing sibling could reflow). ==================== --}}
  {{#if spellbookPage}}
  <button type="button" class="hero-spellbook__slot hero-spellbook__slot--left" data-action="spellbookPage" data-direction="prev"
    aria-label="{{localize 'HEROES_GLORY.Spellbook.PrevPageHint'}}">
    <img src="systems/heroes-glory/assets/ui/speltrnl_rgba.png" alt="">
  </button>
  {{/if}}
  {{#unless (eq spellbookPage spellbookMaxPage)}}
  <button type="button" class="hero-spellbook__slot hero-spellbook__slot--right" data-action="spellbookPage" data-direction="next"
    aria-label="{{localize 'HEROES_GLORY.Spellbook.NextPageHint'}}">
    <img src="systems/heroes-glory/assets/ui/speltrnr_rgba.png" alt="">
  </button>
  {{/unless}}

  {{!-- ==================== Mana (read-only duplicate of the paperdoll's own slot) ====================
    No tooltip here on purpose — this is a bare number sitting on the book's own
    art with nothing to disambiguate (unlike the paperdoll's own mana icon,
    which keeps its `data-tooltip-trigger="mana"` and needs the breakdown since
    it's the only place that value's formula shows). --}}
  <div class="hero-spellbook__slot hero-spellbook__slot--mana">
    <span>{{system.mana.value}}</span>
  </div>

  {{!-- ==================== Close (no extra chrome — the button art is already on the background) ==================== --}}
  <button type="button" class="hero-spellbook__slot hero-spellbook__slot--back" data-action="closeSpellbook"
    aria-label="{{localize 'HEROES_GLORY.Spellbook.CloseHint'}}"></button>

</div>
{{else}}
<div class="hero-paperdoll" data-panel-color="{{effectivePanelColor}}">

  <img class="hero-paperdoll__slot hero-paperdoll__slot--portrait" src="{{actor.img}}" alt="{{actor.name}}"
    data-action="editImage" data-edit="img" role="button" tabindex="0"
    aria-label="{{localize 'HEROES_GLORY.Actor.ChangeImage'}}">

  {{!-- §2.3-2.5: a single 6-column CSS Grid, not two independent flex
    rows — Имя/Уровень each span 3 columns (half the grid each, so they're
    exactly equal to EACH OTHER), Раса/Фракция/Класс each span 2 (a third
    each). Sharing one grid (rather than each row picking its own widths)
    is what makes the two rows' total widths and left/right edges match
    automatically — see _hero-paperdoll.scss's `.hero-paperdoll__slot--name`
    for the column/gap values this guarantees stay identical between rows. --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--name">
    <div class="hero-paperdoll__identity-block hero-paperdoll__identity-block--name">
      <input class="hero-paperdoll__name-input" type="text" name="name" value="{{actor.name}}"
        placeholder="{{localize 'HEROES_GLORY.Actor.NamePlaceholder'}}" {{#unless editMode}}disabled{{/unless}}>
    </div>
    <div class="hero-paperdoll__identity-block hero-paperdoll__identity-block--level{{#if canPickLevel}} hero-paperdoll__name-pick{{/if}}"
      {{#if canPickLevel}}data-action="pickLevel" role="button" tabindex="0"
      aria-label="{{localize 'HEROES_GLORY.Hero.LevelPickHint'}}"{{/if}}>
      <span class="hero-paperdoll__level">{{localize 'HEROES_GLORY.Hero.Level'}} <span class="hero-paperdoll__level-value">{{heroLevel}}</span></span>
    </div>
    {{!-- §2.4/§2.5: Раса, Фракция, Класс — in THIS order, matching the
      derivation direction (class comes from faction, so faction leads it).
      Each is its own bordered block (not a comma-joined line, see
      _hero-paperdoll.scss's `.hero-paperdoll__identity-block` for the
      empty-state rules) — an empty block shows the field's own name
      (HEROES_GLORY.Hero.Race/Faction/Class), not "Не выбрано". --}}
    <span class="hero-paperdoll__identity-block hero-paperdoll__identity-block--race{{#if canPickIdentity.race}} hero-paperdoll__name-pick{{/if}}{{#unless raceLabel}} hero-paperdoll__identity-block--empty{{/unless}}"
      {{#if canPickIdentity.race}}data-action="pickRace" role="button" tabindex="0"
      aria-label="{{localize 'HEROES_GLORY.Hero.RacePickHint'}}"{{/if}}
      {{#if raceLabel}}data-tooltip-trigger="race"{{/if}}>{{#if raceLabel}}{{localize raceLabel}}{{else}}{{localize 'HEROES_GLORY.Hero.Race'}}{{/if}}</span>
    <span class="hero-paperdoll__identity-block hero-paperdoll__identity-block--faction{{#if canPickIdentity.faction}} hero-paperdoll__name-pick{{/if}}{{#unless factionLabel}} hero-paperdoll__identity-block--empty{{/unless}}"
      {{#if canPickIdentity.faction}}data-action="pickFaction" role="button" tabindex="0"
      aria-label="{{localize 'HEROES_GLORY.Hero.FactionPickHint'}}"{{/if}}>{{#if factionLabel}}{{localize factionLabel}}{{else}}{{localize 'HEROES_GLORY.Hero.Faction'}}{{/if}}</span>
    <span class="hero-paperdoll__identity-block hero-paperdoll__identity-block--class{{#if canPickIdentity.classType}} hero-paperdoll__name-pick{{/if}}{{#unless classLabel}} hero-paperdoll__identity-block--empty{{/unless}}{{#if classLocked}} hero-paperdoll__identity-block--locked{{/if}}"
      {{#if canPickIdentity.classType}}data-action="pickClassType" role="button" tabindex="0"
      aria-label="{{localize 'HEROES_GLORY.Hero.ClassPickHint'}}"{{/if}}
      {{#if classLocked}}aria-disabled="true" data-tooltip-trigger="class-locked"{{/if}}>{{#if classLabel}}{{localize identityClassLabel}}{{else}}{{localize 'HEROES_GLORY.Hero.Class'}}{{/if}}</span>
  </div>

  {{!-- §task: Зрение/Скорость — same block style as Раса/Фракция/Класс
    (border+SmallFont, no grid-column span since these sit outside the
    identity grid, positioned by their own $hg-named-slots entries
    instead), free leather strip left of the head slot. Bare value only
    (no "Зрение:"/"Скорость:" prefix) — the field name is the hover
    tooltip, matching every other bare-value identity block. Both are
    edit-mode-only (no "blank field, any owner" exception — unlike Раса/
    Фракция/Класс, these never start genuinely blank, see
    schema.speed/vision's own `initial`).

    stat_backdrop first in DOM, no z-index anywhere on this canvas (see
    the window-frame ::after's own comment on why DOM order alone already
    decides stacking here) — so it paints under both blocks despite
    sharing their exact footprint. Decorative only, aria-hidden. --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--stat_backdrop hero-paperdoll__stat-backdrop" aria-hidden="true"></div>
  <span class="hero-paperdoll__slot hero-paperdoll__slot--stat_speed hero-paperdoll__identity-block"
    data-tooltip-trigger="stat-speed">
    {{!-- Edit mode edits the race base (`source`); otherwise the derived
      total is shown with no `name`, so submitOnChange never writes it
      back into the base (see base-actor-sheet.mjs's `context.source`). --}}
    {{#if editMode}}
    <input class="hero-paperdoll__name-input" type="number" name="system.speed" value="{{source.speed}}" min="0">
    {{else}}
    <input class="hero-paperdoll__name-input" type="number" value="{{system.speed}}" readonly>
    {{/if}}
  </span>
  <span class="hero-paperdoll__slot hero-paperdoll__slot--stat_vision hero-paperdoll__identity-block{{#if editMode}} hero-paperdoll__name-pick{{/if}}"
    {{#if editMode}}data-action="pickVision" role="button" tabindex="0"
    aria-label="{{localize 'HEROES_GLORY.Hero.VisionPickHint'}}"{{/if}}
    data-tooltip-trigger="stat-vision">{{localize visionLabel}}</span>
  <template class="hg-tooltip-tpl" data-tooltip-key="stat-speed">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Speed'}}</p>
    {{#each speedLines}}<p>{{this}}</p>{{/each}}
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="stat-vision">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Vision'}}</p>
  </template>

  {{!-- ==================== Primary skills: labels / icons / values ==================== --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--text_1 hero-paperdoll__primary-row">
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="attack"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.Attack'}}</span>
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="defense"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.Defense'}}</span>
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="magicPower"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.MagicPower'}}</span>
    <span class="hero-paperdoll__primary-cell" data-action="rollAbilityCheck" data-skill="knowledge"
      role="button" tabindex="0" title="{{localize 'HEROES_GLORY.Roll.CheckHint'}}">{{localize 'HEROES_GLORY.Hero.Knowledge'}}</span>
  </div>

  <img class="hero-paperdoll__slot hero-paperdoll__slot--attack" src="{{icons.attack}}" alt=""
    data-tooltip-trigger="skill-attack" data-tooltip-click>
  <img class="hero-paperdoll__slot hero-paperdoll__slot--defence" src="{{icons.defense}}" alt=""
    data-tooltip-trigger="skill-defense" data-tooltip-click>
  {{!-- Class names --knowledge/--witchcraft are just the CSS position hooks
    (3rd/4th slot in the row) — rules.md §2.1's order is Attack, Defense,
    MagicPower, Knowledge, so the 3rd slot (--knowledge) is MagicPower's
    icon/tooltip and the 4th (--witchcraft) is Knowledge's; matches the
    label/value rows above and below, which were never swapped. --}}
  <img class="hero-paperdoll__slot hero-paperdoll__slot--knowledge" src="{{icons.magicPower}}" alt=""
    data-tooltip-trigger="skill-magicPower" data-tooltip-click>
  <img class="hero-paperdoll__slot hero-paperdoll__slot--witchcraft" src="{{icons.knowledge}}" alt=""
    data-tooltip-trigger="skill-knowledge" data-tooltip-click>

  {{!-- Each cell shows the effective (post-artifact) value by default;
    clicking it (editPrimaryStat, hero-sheet.mjs) reveals the input below,
    whose value/name are the pristine base — see the SCSS comment on
    .hero-paperdoll__primary-value-display for why. --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--text_2 hero-paperdoll__primary-row">
    <span class="hero-paperdoll__primary-cell">
      <span class="hero-paperdoll__primary-value-display"{{#if editMode}} data-action="editPrimaryStat"{{/if}}>{{system.attack}}</span>
      <input class="hero-paperdoll__primary-value" type="number" name="system.attack" value="{{source.attack}}" min="0" hidden>
    </span>
    <span class="hero-paperdoll__primary-cell">
      <span class="hero-paperdoll__primary-value-display"{{#if editMode}} data-action="editPrimaryStat"{{/if}}>{{system.defense}}</span>
      <input class="hero-paperdoll__primary-value" type="number" name="system.defense" value="{{source.defense}}" min="0" hidden>
    </span>
    <span class="hero-paperdoll__primary-cell">
      <span class="hero-paperdoll__primary-value-display"{{#if editMode}} data-action="editPrimaryStat"{{/if}}>{{system.magicPower}}</span>
      <input class="hero-paperdoll__primary-value" type="number" name="system.magicPower" value="{{source.magicPower}}" min="0" hidden>
    </span>
    <span class="hero-paperdoll__primary-cell">
      <span class="hero-paperdoll__primary-value-display"{{#if editMode}} data-action="editPrimaryStat"{{/if}}>{{system.knowledge}}</span>
      <input class="hero-paperdoll__primary-value" type="number" name="system.knowledge" value="{{source.knowledge}}" min="0" hidden>
    </span>
  </div>

  {{!-- ==================== Health / Experience / Mana ==================== --}}
  <img class="hero-paperdoll__slot hero-paperdoll__slot--health_name" src="{{icons.health}}" alt=""
    data-tooltip-trigger="health" data-tooltip-click>
  <div class="hero-paperdoll__slot hero-paperdoll__slot--health_desc">
    <span class="hero-paperdoll__value-label">{{localize 'HEROES_GLORY.Hero.Health'}}</span>
    <span class="hero-paperdoll__value-row"><span class="hero-paperdoll__value-wrap"><span class="hero-paperdoll__value-display" aria-hidden="true">{{system.health.value}}</span><input class="hero-paperdoll__value-input" type="number" name="system.health.value" value="{{system.health.value}}" min="0"></span><span class="hero-paperdoll__value-sep">/</span><span class="hero-paperdoll__value-max">{{system.health.max}}</span></span>
  </div>

  {{!-- §4.2: a slow-pulsing highlight frame over the WHOLE Опыт block
    (icon + label + value, not just the label) once a level-up is
    available — placed before experience_name/experience_desc in the DOM
    so normal stacking order paints their icon/text over it with no
    z-index needed; see _hero-paperdoll.scss for the rest. Purely
    decorative — not a click target, no data-action of its own; that
    already showing frame is the only "you can click here" signal this
    block gets (no color change, no cursor change, no animation on the
    icon/text themselves). --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--experience_highlight{{#if canLevelUp}} hero-paperdoll__slot--experience_highlight--active{{/if}}" aria-hidden="true"></div>

  {{!-- §4.2 (click area): the icon and the label/value/max text each carry
    their own data-action when a level-up is available, matching how
    experience_desc alone already worked before this — clicking the star
    icon now opens the level-up window too, exactly like clicking the
    label/value/max already did. `.hero-paperdoll__value-input` is the one
    exception: it's still a live editable field, isolated via its own
    stopPropagation listener (hero-sheet.mjs's `_onRender`).
    data-tooltip-click on the icon is suppressed while canLevelUp so a
    left-click doesn't also pin the plain tooltip on top of opening the
    level-up window; data-tooltip-trigger stays unconditional so
    right-click-hold keeps working exactly as before. --}}
  <img class="hero-paperdoll__slot hero-paperdoll__slot--experience_name" src="{{icons.experience}}" alt=""
    data-tooltip-trigger="experience" {{#unless canLevelUp}}data-tooltip-click{{/unless}}
    {{#if canLevelUp}}data-action="openLevelUp" role="button" tabindex="0"
    aria-label="{{localize 'HEROES_GLORY.Hero.Experience'}}"
    data-tooltip="{{localize 'HEROES_GLORY.LevelUp.AvailableHint'}}"{{/if}}>
  <div class="hero-paperdoll__slot hero-paperdoll__slot--experience_desc"
    {{#if canLevelUp}}data-action="openLevelUp" role="button" tabindex="0"
    data-tooltip="{{localize 'HEROES_GLORY.LevelUp.AvailableHint'}}"{{/if}}>
    <span class="hero-paperdoll__value-label">{{localize 'HEROES_GLORY.Hero.Experience'}}</span>
    <span class="hero-paperdoll__value-row"><span class="hero-paperdoll__value-wrap"><span class="hero-paperdoll__value-display" aria-hidden="true">{{system.experience}}</span><input class="hero-paperdoll__value-input" type="number" name="system.experience" value="{{system.experience}}" min="0" {{#unless editMode}}readonly{{/unless}}></span><span class="hero-paperdoll__value-sep">/</span><span class="hero-paperdoll__value-max">{{experienceForNextLevel}}</span></span>
  </div>

  <img class="hero-paperdoll__slot hero-paperdoll__slot--mana_name" src="{{icons.mana}}" alt=""
    data-tooltip-trigger="mana" data-tooltip-click>
  <div class="hero-paperdoll__slot hero-paperdoll__slot--mana_desc">
    <span class="hero-paperdoll__value-label">{{localize 'HEROES_GLORY.Hero.Mana'}}</span>
    <span class="hero-paperdoll__value-row"><span class="hero-paperdoll__value-wrap"><span class="hero-paperdoll__value-display" aria-hidden="true">{{system.mana.value}}</span><input class="hero-paperdoll__value-input" type="number" name="system.mana.value" value="{{source.mana.value}}" min="0"></span><span class="hero-paperdoll__value-sep">/</span><span class="hero-paperdoll__value-max">{{system.mana.max}}</span></span>
  </div>

  {{!-- ==================== Morale / Luck ====================
    Icons show the derived total. In edit mode each slot shows the GM's
    manual correction instead (the only stored part, rules.md §3/§11),
    edited through the same display→input swap as the primary skills
    (editPrimaryStat). --}}
  {{#if editMode}}
  <span class="hero-paperdoll__slot hero-paperdoll__slot--morale hero-paperdoll__correction"
    data-tooltip-trigger="morale" title="{{localize 'HEROES_GLORY.Hero.MoraleCorrection'}}">
    <span class="hero-paperdoll__primary-value-display" data-action="editPrimaryStat">{{source.morale}}</span>
    <input class="hero-paperdoll__primary-value" type="number" name="system.morale" value="{{source.morale}}" hidden>
  </span>
  <span class="hero-paperdoll__slot hero-paperdoll__slot--luck hero-paperdoll__correction"
    data-tooltip-trigger="luck" title="{{localize 'HEROES_GLORY.Hero.LuckCorrection'}}">
    <span class="hero-paperdoll__primary-value-display" data-action="editPrimaryStat">{{source.luck}}</span>
    <input class="hero-paperdoll__primary-value" type="number" name="system.luck" value="{{source.luck}}" hidden>
  </span>
  {{else}}
  <img class="hero-paperdoll__slot hero-paperdoll__slot--morale" src="{{icons.morale}}" alt=""
    data-tooltip-trigger="morale"{{#if canRollMorale}} data-action="rollMoraleCheck"{{/if}}>
  <img class="hero-paperdoll__slot hero-paperdoll__slot--luck" src="{{icons.luck}}" alt=""
    data-tooltip-trigger="luck" data-tooltip-click>
  {{/if}}

  {{!-- ==================== Secondary skills (8 slots, scrolls past 8 —
    see _hero-paperdoll.scss's own comment on
    .hero-paperdoll__secondary-skills-scroll for why this is keyed to
    secondarySkillsScrollable, not to Экспертная Обучаемость directly)
    ==================== --}}
  {{#if secondarySkillsScrollable}}
    {{!-- Outer: the plain $hg-named-slots frame, untouched, overflow:visible
      (no rule of its own beyond .hero-paperdoll__slot's base). Inner: the
      actual scrolling/grid element, deliberately wider than the frame — see
      .hero-paperdoll__secondary-skills-scroll's own comment in
      _hero-paperdoll.scss for why (scrollbar-gutter bleed fix). --}}
    <div class="hero-paperdoll__slot hero-paperdoll__slot--secondary_skills_scroll">
      <div class="hero-paperdoll__secondary-skills-scroll">
        {{#each secondarySkillSlots}}
          <div class="hero-paperdoll__skill-cell">
            <div class="hero-paperdoll__skill-cell-icon">
              {{#if this}}
                <img class="hero-paperdoll__icon-img" src="{{this.icon}}" data-item-id="{{this.item.id}}"
                  {{#if ../editMode}}data-action="openItem"{{/if}}
                  data-tooltip-trigger="secskill-{{inc @index}}" data-tooltip-click>
                {{#if ../editMode}}
                  <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.item.id}}"
                    title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
                {{/if}}
                <template class="hg-tooltip-tpl" data-tooltip-key="secskill-{{inc @index}}">
                  <img class="hg-tooltip__icon" src="{{this.iconLarge}}" width="82" height="93" alt="">
                  <p class="hg-tooltip__title">{{localize this.skillLabel}} — {{localize this.tierLabel}}</p>
                  <p>{{this.effectText}}</p>
                </template>
              {{/if}}
            </div>
            <div class="hero-paperdoll__skill-cell-desc">
              {{#if this}}<span>{{localize this.tierLabel}}</span><span>{{localize this.skillLabel}}</span>{{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  {{else}}
    {{#each secondarySkillSlots}}
      <div class="hero-paperdoll__slot hero-paperdoll__slot--skill_name_{{inc @index}}">
        {{#if this}}
          <img class="hero-paperdoll__icon-img" src="{{this.icon}}" data-item-id="{{this.item.id}}"
            {{#if ../editMode}}data-action="openItem"{{/if}}
            data-tooltip-trigger="secskill-{{inc @index}}" data-tooltip-click>
          {{#if ../editMode}}
            <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.item.id}}"
              title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
          {{/if}}
          <template class="hg-tooltip-tpl" data-tooltip-key="secskill-{{inc @index}}">
            <img class="hg-tooltip__icon" src="{{this.iconLarge}}" width="82" height="93" alt="">
            <p class="hg-tooltip__title">{{localize this.skillLabel}} — {{localize this.tierLabel}}</p>
            <p>{{this.effectText}}</p>
          </template>
        {{/if}}
      </div>
      <div class="hero-paperdoll__slot hero-paperdoll__slot--skill_desc_{{inc @index}}">
        {{#if this}}<span>{{localize this.tierLabel}}</span><span>{{localize this.skillLabel}}</span>{{/if}}
      </div>
    {{/each}}
  {{/if}}

  {{!-- ==================== Left-half tooltip content (module/helpers/tooltip.mjs) ==================== --}}
  {{!-- §2.3: only rendered (and only triggerable — see the identity block
    above) once a race is actually chosen. Shows the race's own feature
    text (RaceFeature.* — previously only surfaced inside the race-change
    confirm dialog, now also available at rest) plus, for Элементаль/
    Минотавр, the currently chosen subchoice — the identity block itself
    stays the bare race name regardless (fixed width, see
    IDENTITY_SHORT_CLASS_LABELS' own comment for why nothing gets appended
    there). --}}
  <template class="hg-tooltip-tpl" data-tooltip-key="race">
    <p class="hg-tooltip__title">{{localize raceLabel}}</p>
    {{#if raceFeatureNoteKey}}<p>{{localize raceFeatureNoteKey}}</p>{{/if}}
    {{#if raceSubchoiceLine}}<p>{{raceSubchoiceLine}}</p>{{/if}}
  </template>
  {{!-- §task: class block locked (no faction chosen yet) — hover-only,
    same mechanism as "race" above, no click-to-pin (no bare
    data-tooltip-click on the trigger). --}}
  <template class="hg-tooltip-tpl" data-tooltip-key="class-locked">
    <p>{{localize 'HEROES_GLORY.Hero.ClassLockedHint'}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-attack">
    <img class="hg-tooltip__icon" src="{{icons.attackLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Attack'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.attack}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.attack}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-defense">
    <img class="hg-tooltip__icon" src="{{icons.defenseLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Defense'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.defense}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.defense}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-magicPower">
    <img class="hg-tooltip__icon" src="{{icons.magicPowerLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.MagicPower'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.magicPower}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.magicPower}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="skill-knowledge">
    <img class="hg-tooltip__icon" src="{{icons.knowledgeLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Knowledge'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.BaseValue' value=source.knowledge}}</p>
    <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.knowledge}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="health">
    <img class="hg-tooltip__icon" src="{{icons.healthLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Health'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.CurrentOfMax' current=system.health.value max=system.health.max}}</p>
    {{#if system.wounds}}
      <p>{{localize 'HEROES_GLORY.Tooltip.HealthWoundBreakdown' base=system.health.base wounds=system.wounds afterWounds=healthAfterWounds}}</p>
      {{#unless (eq healthAfterWounds system.health.max)}}
        <p>{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.health.max}}</p>
      {{/unless}}
    {{/if}}
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="experience">
    <img class="hg-tooltip__icon" src="{{icons.experienceLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Experience'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.ExperienceCurrent' value=system.experience}}</p>
    {{#if experienceToNext}}
      <p>{{localize 'HEROES_GLORY.Tooltip.ExperienceToNext' value=experienceToNext}}</p>
    {{/if}}
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="morale">
    <img class="hg-tooltip__icon" src="{{icons.moraleLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Morale'}}: {{system.morale}}</p>
    {{#each moraleLines}}<p>{{this}}</p>{{/each}}
    {{#if moraleAttemptsLine}}<p>{{moraleAttemptsLine}}</p>{{/if}}
    <p>{{localize 'HEROES_GLORY.Tooltip.MoralePositiveHint'}}</p>
  </template>
  <template class="hg-tooltip-tpl" data-tooltip-key="luck">
    <img class="hg-tooltip__icon" src="{{icons.luckLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Luck'}}: {{system.luck}}</p>
    {{#each luckLines}}<p>{{this}}</p>{{/each}}
    <p>{{localize 'HEROES_GLORY.Tooltip.LuckHint'}}</p>
  </template>

  {{!-- ==================== Paperdoll (19 slots) ==================== --}}
  {{#each paperdollSlots}}
    <div class="hero-paperdoll__slot hero-paperdoll__slot--paperdoll-{{this.index}}" data-slot="{{this.index}}"
      {{#if this.opensRaceSpells}}data-action="openSpellbook" title="{{localize 'HEROES_GLORY.Spellbook.RaceSpellsHint'}}"{{/if}}>
      {{#if this.item}}
        {{!-- §5.3: a weapon only attacks on click while equipped (always
          true here — a paperdoll slot only ever holds an equipped item —
          but not in the backpack loop below, where the same weapon can
          land after being unequipped). Edit mode off + unequipped: no
          `data-action` at all, same as an artifact — left click is a
          no-op there, not a tooltip (paperdoll/backpack icons never get
          `data-tooltip-click`, see the trigger-binding loop in
          hero-sheet.mjs's `_onRender`). An artifact whose artifactType is
          "enchantedWeapon" counts as a weapon here too (§8.2 — made to
          behave exactly like a real one once equipped); the other 5
          artifact types fall through to the plain editMode-only branch,
          same as before. --}}
        <img class="draggable hero-paperdoll__icon-img" src="{{this.item.img}}" data-item-id="{{this.item.id}}"
          {{#if (eq this.item.type 'spellbook')}}data-action="openSpellbook"
          {{else if (or (eq this.item.type 'weapon') (and (eq this.item.type 'artifact') (eq this.item.system.artifactType 'enchantedWeapon')))}}{{#if ../editMode}}data-action="openItem"{{else if this.item.system.equipped}}data-action="rollAttack"{{/if}}
          {{else if ../editMode}}data-action="openItem"{{/if}}
          data-tooltip-trigger="paperdoll-{{this.index}}">
        {{#if ../editMode}}
          <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.item.id}}"
            title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
        {{/if}}
        <template class="hg-tooltip-tpl" data-tooltip-key="paperdoll-{{this.index}}">
          <p class="hg-tooltip__title">{{this.item.name}}</p>
        </template>
      {{/if}}
    </div>
  {{/each}}

  {{!-- ==================== Backpack (5 visible, scrolls 1 slot at a time) + arrows ==================== --}}
  {{#each backpackVisibleItems}}
    <div class="hero-paperdoll__slot hero-paperdoll__slot--backpack-{{inc @index}}" data-slot="backpack">
      {{#if this}}
        <img class="draggable hero-paperdoll__icon-img" src="{{this.img}}" data-item-id="{{this.id}}"
          {{#if (eq this.type 'spellbook')}}data-action="openSpellbook"
          {{else if (or (eq this.type 'weapon') (and (eq this.type 'artifact') (eq this.system.artifactType 'enchantedWeapon')))}}{{#if ../editMode}}data-action="openItem"{{else if this.system.equipped}}data-action="rollAttack"{{/if}}
          {{else if ../editMode}}data-action="openItem"{{/if}}
          data-tooltip-trigger="backpack-{{inc @index}}">
        {{#if ../editMode}}
          <button type="button" class="hero-paperdoll__slot-delete" data-action="deleteItem" data-item-id="{{this.id}}"
            title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
        {{/if}}
        <template class="hg-tooltip-tpl" data-tooltip-key="backpack-{{inc @index}}">
          <p class="hg-tooltip__title">{{this.name}}</p>
        </template>
      {{/if}}
    </div>
  {{/each}}

  <button type="button" class="hero-paperdoll__slot hero-paperdoll__slot--arrow_left{{#if (eq backpackPressedDirection 'prev')}} hero-paperdoll__slot--pressed{{/if}}"
    data-action="backpackScroll" data-direction="prev"
    {{#unless backpackOffset}}disabled{{/unless}} aria-label="{{localize 'HEROES_GLORY.Hero.BackpackPrevHint'}}"></button>
  <button type="button" class="hero-paperdoll__slot hero-paperdoll__slot--arrow_right{{#if (eq backpackPressedDirection 'next')}} hero-paperdoll__slot--pressed{{/if}}"
    data-action="backpackScroll" data-direction="next"
    {{#if (eq backpackOffset backpackMaxOffset)}}disabled{{/if}} aria-label="{{localize 'HEROES_GLORY.Hero.BackpackNextHint'}}"></button>

  {{!-- ==================== Free zone below the inventory (docs/paperdoll_grid.json's
       "edit_zone") ==================== --}}
  {{!-- §4.3 p.23: Специализация — unlike edit_button_toggle below, shown
    unconditionally (not `{{#if editMode}}`-gated): it's a permanent
    character feature, not an edit-mode workflow control, so it has to be
    visible at rest same as any other paperdoll slot. Reuses the
    secondary-skill cell markup verbatim (same `.hero-paperdoll__skill-
    cell`/`-icon`/`-desc` classes, same tooltip mechanism) — combined
    with `.hero-paperdoll__slot--specialization` for its position (see
    that $hg-named-slots entry's own comment in _hero-paperdoll.scss for
    where this box came from). data-action lives on the outer cell, not
    the (conditionally-rendered) icon inside it — unlike a secondary
    skill slot, this one must stay clickable even empty, to open the
    picker and choose one; #onPickSpecialization is what actually gates
    whether clicking it does anything (level 10+, edit mode or first
    pick — see that method's own comment), same silent-no-op convention
    every other identity picker here already uses. --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--specialization hero-paperdoll__skill-cell"
    {{#if specializationPickable}}data-action="pickSpecialization" role="button" tabindex="0"
    aria-label="{{localize 'HEROES_GLORY.Hero.SpecializationPickHint'}}"{{/if}}>
    <div class="hero-paperdoll__skill-cell-icon">
      {{#if specializationSlot}}
        <img class="hero-paperdoll__icon-img" src="{{specializationSlot.icon}}" alt=""
          data-tooltip-trigger="specialization" data-tooltip-click>
        {{#if editMode}}
          <button type="button" class="hero-paperdoll__slot-delete" data-action="unsetSpecialization"
            title="{{localize 'HEROES_GLORY.Item.DeleteHint'}}">&times;</button>
        {{/if}}
        <template class="hg-tooltip-tpl" data-tooltip-key="specialization">
          <img class="hg-tooltip__icon" src="{{specializationSlot.iconLarge}}" width="82" height="93" alt="">
          <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Specialization'}} — {{specializationSlot.label}}</p>
          {{#if specializationSlot.effectTextKey}}<p>{{localize specializationSlot.effectTextKey}}</p>{{/if}}
        </template>
      {{/if}}
    </div>
    <div class="hero-paperdoll__skill-cell-desc">
      {{#if specializationSlot}}<span>{{localize 'HEROES_GLORY.Hero.Specialization'}}</span><span>{{specializationSlot.label}}</span>{{/if}}
    </div>
  </div>
  {{!-- Same highlight frame as Опыт's level-up (experience_highlight) — lit
    only while a pick is available and nothing is chosen yet. Comes AFTER
    the cell in the DOM (unlike experience_highlight, which comes before
    experience_name/_desc) so it paints on top: Опыт's icon+desc are
    smaller than its highlight box (deliberately expanded past them, see
    that box's own $hg-experience-highlight-*-expand comment), leaving a
    blank margin the border shows through in either paint order — this
    cell's own background (secondary_skill_rows.png) covers its box edge
    to edge with no such margin, so painting first left the border fully
    covered every time, confirmed live via elementsFromPoint before this
    change. `pointer-events: none` (already on the shared frame) means
    sitting on top doesn't block clicks through to the cell below. --}}
  <div class="hero-paperdoll__slot hero-paperdoll__slot--specialization_highlight{{#if specializationHighlight}} hero-paperdoll__slot--specialization_highlight--active{{/if}}" aria-hidden="true"></div>

  {{!-- Цвет панели moved to this window's own header-control menu (the
    "…" button in the OS titlebar, ApplicationV2's own _getHeaderControls
    — see hero-sheet.mjs's own comment) — no button left here for it.
    Шрифт (temporary client-demo picker) removed entirely, not relocated. --}}
  <button type="button" class="hero-paperdoll__slot hero-paperdoll__slot--edit_button_toggle" data-action="toggleEditMode"
    {{#unless isGM}}disabled{{/unless}}
    aria-pressed="{{editMode}}"
    aria-label="{{#if isGM}}{{#if editMode}}{{localize 'HEROES_GLORY.Hero.EditModeDisableHint'}}{{else}}{{localize 'HEROES_GLORY.Hero.EditModeEnableHint'}}{{/if}}{{else}}{{localize 'HEROES_GLORY.Hero.EditModeGmOnlyHint'}}{{/if}}"></button>


</div>
{{/if}}
{{!-- /.hero-paperdoll or .hero-spellbook. --}}

  {{!-- Shared by both canvases (mutually exclusive above, never both in
       the DOM at once) — the Mana tooltip content is identical either
       way, so one copy covers both `data-tooltip-trigger="mana"` triggers. --}}
  <template class="hg-tooltip-tpl" data-tooltip-key="mana">
    <img class="hg-tooltip__icon" src="{{icons.manaLarge}}" width="82" height="93" alt="">
    <p class="hg-tooltip__title">{{localize 'HEROES_GLORY.Hero.Mana'}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.CurrentOfMax' current=system.mana.value max=system.mana.max}}</p>
    <p>{{localize 'HEROES_GLORY.Tooltip.ManaFormula' knowledge=system.knowledge multiplier=manaMultiplier product=manaBeforeWounds}}</p>
  </template>

  {{!-- <details class="hero-paperdoll__more"> (specialization, morale/luck
       edit fields + test buttons, wounds counter, post-battle checks,
       Speed/Vision/Gold, base Health, spells list with cast/delete/open)
       intentionally removed — the hero sheet is picture-only now,
       toggling only to the spellbook. Race/Faction/Class/panel-color
       editing (the `<select>`s that used to live in this same removed
       block) came back as the pinTooltip-based pickers above/in edit_zone
       instead of a restored `<details>` — see hero-sheet.mjs's
       #openOptionPicker. Everything else it drove is still reachable from
       Foundry's own sidebar (each owned item's own sheet, the actor's
       core fields) until a fuller edit-mode UI is designed for this
       system; the underlying context fields/calculations/actions in
       hero-sheet.mjs are untouched and still work, just unread by this
       template for now — see the comments next to them there. --}}

</div>
{{! /.hero-paperdoll-wrapper }}

