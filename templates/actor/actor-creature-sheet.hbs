<section class="actor-sheet__body actor-sheet__body--creature">
  <div class="grid grid-3col">
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Creature.Faction'}}</span>
      <select name="system.faction">
        {{selectOptions config.factions selected=system.faction localize=true}}
      </select>
    </label>
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Creature.Level'}}</span>
      <input type="number" name="system.level" value="{{system.level}}" min="0">
    </label>
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">
        {{localize 'HEROES_GLORY.Creature.Speed'}}
        {{#unless (eq source.speed system.speed)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.speed}}</span>{{/unless}}
      </span>
      <input type="number" name="system.speed" value="{{source.speed}}" min="0">
    </label>
  </div>

  <div class="grid grid-4col">
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">
        {{localize 'HEROES_GLORY.Creature.Attack'}}
        {{#unless (eq source.attack system.attack)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.attack}}</span>{{/unless}}
      </span>
      <input type="number" name="system.attack" value="{{source.attack}}" min="0">
    </label>
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">
        {{localize 'HEROES_GLORY.Creature.Defense'}}
        {{#unless (eq source.defense system.defense)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.defense}}</span>{{/unless}}
      </span>
      <input type="number" name="system.defense" value="{{source.defense}}" min="0">
    </label>
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Creature.Damage'}}</span>
      <input type="number" name="system.damage" value="{{system.damage}}" min="0">
    </label>
    <label class="actor-sheet__field">
      <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Creature.AttacksCount'}}</span>
      <input type="number" name="system.attacksCount" value="{{system.attacksCount}}" min="0">
    </label>
  </div>

  <div class="grid grid-2col">
    <p class="actor-sheet__computed">{{localize 'HEROES_GLORY.Creature.DamageWeak'}}: {{damageWeak}}</p>
    <p class="actor-sheet__computed">{{localize 'HEROES_GLORY.Creature.DamageStrong'}}: {{damageStrong}}</p>
  </div>

  <div class="actor-sheet__attack-row" data-action="rollAttack" role="button" tabindex="0"
    title="{{localize 'HEROES_GLORY.Roll.AttackHint'}}">
    {{localize 'HEROES_GLORY.Roll.AttackRow' attack=system.attack damage=system.damage count=system.attacksCount}}
  </div>

  <div class="actor-sheet__field">
    <span class="actor-sheet__label">
      {{localize 'HEROES_GLORY.Creature.Health'}}
      {{#unless (eq source.health.max system.health.max)}}<span class="actor-sheet__field-total">{{localize 'HEROES_GLORY.Actor.EffectiveValue' value=system.health.max}}</span>{{/unless}}
    </span>
    <div class="actor-sheet__value-pair">
      <input type="number" name="system.health.value" value="{{system.health.value}}" min="0">
      <span class="actor-sheet__value-sep">/</span>
      <input type="number" name="system.health.max" value="{{source.health.max}}" min="0">
    </div>
  </div>

  <fieldset class="actor-sheet__special-skills">
    <legend>{{localize 'HEROES_GLORY.Creature.SpecialSkills'}}</legend>
    {{#each system.specialSkills}}
      <input type="text" class="actor-sheet__special-skill" name="system.specialSkills.{{@index}}" value="{{this}}">
    {{/each}}
    <input type="text" class="actor-sheet__special-skill" name="system.specialSkills.{{system.specialSkills.length}}" value="">
  </fieldset>

  <fieldset class="item-sheet__epic-table">
    <legend>{{localize 'HEROES_GLORY.Creature.EpicTable'}}</legend>
    {{#each system.epicTable}}
      <label class="actor-sheet__field">
        <span class="actor-sheet__label">{{localize 'HEROES_GLORY.Creature.EpicRow'}} {{inc @index}}</span>
        <input type="text" name="system.epicTable.{{@index}}" value="{{this}}">
      </label>
    {{/each}}
  </fieldset>
</section>
